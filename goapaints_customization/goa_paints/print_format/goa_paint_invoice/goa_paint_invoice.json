 "doctype": "Print Format",
 "font": "Default",
 "html": "\r\n<div class=\"invoicetable\" >\r\n {%- from \"templates/print_formats/standard_macros.html\" import add_header,render_field -%}  \r\n {% if print_settings.repeat_header_footer %}\r\n<div  id=\"header-html\" class=\"hidden-pdf\" >\r\n                    \t\t\r\n        {{ add_header(page_num, max_pages, doc, letter_head, no_letterhead, footer, print_settings) }}\r\n</div>\r\n{% endif %}\r\n    \r\n    <table class=\"tg\" width=\"100%\">\r\n        <thead>\r\n          <tr>\r\n            <th class=\"tg-0lax\" colspan=\"2\">IRN:{%if doc.irn %}{{doc.irn}}{%else%} - {% endif %}</th>\r\n            <th class=\"tg-0lax\" colspan=\"2\">Ack No:</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr>\r\n            <td class=\"tg-0lax\" colspan=\"2\" rowspan=\"6\">Goa Paints</td>\r\n            <td class=\"tg-0lax\">Inv No:{{doc.name}}</td>\r\n            <td class=\"tg-0lax\" rowspan=\"6\" width=\"25%\">\r\n                <div>\r\n                    <div style=\"text-align:center;font-size:14px\">\r\n                       E-Invoice \r\n                    </div>\r\n                    <div>\r\n                        <img src=\"https://manisales.frappe.cloud/files/Mani%20Sales%20Qr%20Code.png\" alt=\"Image\" width=\"135\" height=\"135\" style=\"margin-left:10px;\">\r\n                    </div>\r\n                </div>    \r\n            </td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"tg-0lax\">Inv Date:<b>{{frappe.format(doc.posting_date ,{'fieldtype':'Date'})}}</b></td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"tg-0lax\">D.N.NO:{% if doc.items[0].delivery_note %}{{doc.items[0].delivery_note}}{% endif %}</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"tg-0lax\">D.N.Date</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"tg-0lax\">Order No:<b>{% if doc.po_no %}{{doc.po_no}}{% endif %}</b></td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"tg-0lax\">Order date:<b>{{frappe.format(doc.po_date ,{'fieldtype':'Date'})}}</b></td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"tg-0lax\" colspan=\"2\" rowspan=\"2\" width=\"50%\">Billing Address:<b>{{doc.customer_name}}</b><br>{% if doc.address_display %}{{doc.address_display}}{% else%} - {% endif %}</td>\r\n            <td class=\"tg-0lax\" colspan=\"2\" rowspan=\"2\">Shipping Address:<b>{{doc.customer_name}}</b><br>{% if doc.shipping_address %}{{doc.shipping_address}}{% else %}- {% endif %}</td>\r\n          </tr>\r\n          <tr>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"tg-0lax\">Payment Terms:<b>{% if doc.payment_terms_template%}{{doc.payment_terms_template}}{% endif %}</b></td>\r\n            <td class=\"tg-0lax\">Due Date:<b>{{frappe.format(doc.due_date ,{'fieldtype':'Date'})}}</b></td>\r\n            <td class=\"tg-0lax\">Transporter</td>\r\n            <td class=\"tg-0lax\">LR No</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"tg-0lax\" colspan=\"2\">\r\n                <div class=\"row\" >\r\n                    <div class=\"col-xs-4\" >\r\n                       <b>Articles:</b> \r\n                    </div>\r\n                    <div class=\"col-xs-4\">\r\n                       <b>{% if doc.drums %}{{ doc.drums }}{% endif %}:Drums</b>        \r\n                    </div>\r\n                    <div class=\"col-xs-4\">\r\n                       <b>{% if doc.boxes %}{{doc.boxes}}{% endif %}:Boxes</b> \r\n                    </div>\r\n                </div>   \r\n            </td>\r\n            <td class=\"tg-0lax\">Destination</td>\r\n            <td class=\"tg-0lax\">EWB No:<b>{% if doc.ewaybill %}{{ doc.ewaybill }}{% endif %}</b></td>\r\n          </tr>\r\n        </tbody>\r\n</table>\r\n    \r\n<table class=\"tg\" width=\"100%\">\r\n    <thead>\r\n      <!--<tr>-->\r\n      <!--  <th class=\"tg-0lax\"><b>Sr No</b></th>-->\r\n      <!--  <th class=\"tg-0lax\"><b>Item No</b></th>-->\r\n      <!--  <th class=\"tg-0lax\"><b>Item Name</b></th>-->\r\n      <!--  <th class=\"tg-0lax\"><b>HSN/SAC</b></th>-->\r\n      <!--  <th class=\"tg-0lax\"><b>Qty</b></th>-->\r\n      <!--  <th class=\"tg-0lax\"><b>Unit Rate</b></th>-->\r\n      <!--  <th class=\"tg-0lax\"><b>Amount</b></th>-->\r\n      <!--</tr>-->\r\n      <tr>\r\n        <th class=\"tg-0lax\" style=\"width:4%;white-space:nowrap\"><b>Sr No</b></th>\r\n        <th class=\"tg-0lax\"><b>Item Detail</b></th>\r\n        <th class=\"tg-0lax\"><b>HSN/SAC</b></th>\r\n        <th class=\"tg-0lax\"><b>Pack</b></th>\r\n        <th class=\"tg-0lax\"><b>Unit</b></th>\r\n        <th class=\"tg-0lax\"><b>Qty</b></th>\r\n        <th class=\"tg-0lax\"><b>Rate</b></th>\r\n        \r\n        <th class=\"tg-0lax\"><b>Amount</b></th>\r\n      </tr>\r\n    </thead>\r\n    <tbody>\r\n    {% for item in doc.items%}\r\n      <tr>\r\n        <td class=\"tg-0lax\" >{{loop.index}}</td>\r\n        <td class=\"tg-0lax\" style=\"width:50%\">{{item.item_name}}<br>{% if item.batch_no %}{{item.batch_no}}{% endif %}/{{frappe.utils.formatdate(doc.posting_date, 'MM-YYYY')}}<br>{% if item.additional_info %}{{item.additional_info}}{% endif %}</td>\r\n        <td class=\"tg-0lax\" style=\"width:10%\">{{item.gst_hsn_code}}</td>\r\n        <td class=\"tg-0lax\" >{{item.packing}}</td>\r\n        <td class=\"tg-0lax\" style=\"white-space:nowrap\" >{{item.uom}}</td>\r\n        <td class=\"tg-0lax\" style=\"white-space:nowrap;\">{{item.qty|int}}</td>\r\n        <td class=\"tg-0lax\" style=\"white-space:nowrap\">{{frappe.format(item.rate,{'fieldtype':'Currency'})}}</td>\r\n        <td class=\"tg-0lax\" style=\"white-space:nowrap\" >{{frappe.format(item.amount,{'fieldtype':'Currency'})}}</td>\r\n      </tr>\r\n    {% endfor %}\r\n      <tr>\r\n        <td class=\"tg-0lax\" colspan=\"2\"><b>TOTAL</b></td>\r\n        <td class=\"tg-0lax\"></td>\r\n        <td class=\"tg-0lax\"></td>\r\n        <td class=\"tg-0lax\"></td>\r\n        <td class=\"tg-0lax\"><b>{{doc.total_qty|int}}</b></td>\r\n        <td class=\"tg-0lax\"></td>\r\n        <td class=\"tg-0lax\"><b></b>{{frappe.format(doc.total,{'fieldtype':'Currency'})}}</td>\r\n      </tr>\r\n      <!--<tr>-->\r\n      <!--  <td class=\"tg-0lax\" colspan=\"8\">Amount Chargeable(In Words):<b>{{frappe.utils.money_in_words(doc.total)}}</b></td>-->\r\n      <!--</tr>-->\r\n      </tbody>\r\n</table>\r\n\r\n<table class=\"tg\" width=\"100%\">\r\n        <thead>\r\n          <tr>\r\n            <td colspan=\"2\" rowspan=\"3\" width=\"62.4%\">Remarks:</td>\r\n            <td>Net Total</td>\r\n            <td>{{frappe.format(doc.total,{'fieldtype':'Currency'})}}</td>\r\n          </tr>\r\n          {% for tax in doc.taxes %}\r\n          <tr>\r\n            <td>{{ tax.account_head.split('-')[0] }}</td>\r\n            <td>{{frappe.format(tax.tax_amount_after_discount_amount, {'fieldtype': 'Currency'})}}</td>\r\n          </tr>\r\n          {% endfor %}\r\n          <!--<tr>-->\r\n          <!--  <th>Tax GST</th>-->\r\n          <!--  <th></th>-->\r\n          <!--</tr>-->\r\n        </thead>\r\n        <tbody>\r\n          <tr>\r\n            <td colspan=\"2\"> T&C: 1) Goods once sold will not be taken back. 2) Interest on delayed payment as per MSME Act. 3) Disputes subject to Goa Jurisdiction</td>\r\n            <td>Grand Total</td>\r\n            <td>{{frappe.format(doc.grand_total,{'fieldtype':'Currency'})}}</td>\r\n          </tr>\r\n          <tr>\r\n            <td colspan=\"4\">Amount In Words:{{doc.in_words}}</td>\r\n          </tr>\r\n        </tbody>\r\n</table>\r\n        \r\n<table style=\"margin-top:-20px\">\r\n    {% if doc.other_charges_calculation %} {{doc.other_charges_calculation}}{% endif %}\r\n</table>\r\n        \r\n    <!--<table class=\"tg\" width=\"100%\" style=\"margin-top:-20px\">-->\r\n    <!--    <thead>-->\r\n    <!--      <tr>-->\r\n    <!--        <td class=\"tg-0lax\" colspan=\"4\">Amount Chargeable(In Words):<b>{{frappe.utils.money_in_words(doc.total_taxes_and_charges)}}</b></td>-->\r\n    <!--      </tr>-->\r\n    <!--    </thead>-->\r\n    <!--</table>-->\r\n    <!--<table class=\"tg\" width=\"100%\">-->\r\n    <!--    <tbody>-->\r\n    <!--        <tr>-->\r\n                <!--<td class=\"tg-0lax\" colspan=\"2\" width=\"50%\">Terms &amp; Conditions:</td>-->\r\n                <!--<td class=\"tg-0lax\" colspan=\"2\" width=\"50%\">Company Account Details:</td>-->\r\n    <!--        </tr>-->\r\n    <!--    </tbody>-->\r\n    <!--</table>-->\r\n    <!--<table class=\"tg\" width=\"100%\" style=\"margin-top:-20px\">-->\r\n    <!--    <tbody>-->\r\n    <!--        <tr>-->\r\n    <!--            <td class=\"tg-0lax\"  width=\"50%\">-->\r\n    <!--                Terms And Conditions:-->\r\n    <!--                <b>{% if doc.terms%}{{doc.terms}}{% endif %}</b>-->\r\n    <!--            </td>-->\r\n                <!--<td class=\"tg-0lax\" colspan=\"2\" rowspan=\"2\" width=\"50%\">-->\r\n                <!--   <b style=\"text-transform:uppercase\">Bank A/c holder's Name: </b> <br>-->\r\n                <!--   <b style=\"text-transform:uppercase\">Bank Name:</b> <br>-->\r\n                <!--   <b style=\"text-transform:uppercase\">A/c No.:</b><br>-->\r\n                <!--   <b style=\"text-transform:uppercase\">Branch &amp; IFS Code :</b> -->\r\n                <!--</td>-->\r\n    <!--        </tr>-->\r\n    <!--    </tbody>-->\r\n    <!--</table>-->\r\n    <table class=\"tg\" width=\"100%\" style=\"margin-top:-20px\">\r\n        <tbody>\r\n            <tr>\r\n                <td class=\"tg-0lax\" colspan=\"2\" width=\"33%\">\r\n                   <b style=\"text-transform:uppercase\">Name: Goa Paints</b> <br>\r\n                   <b style=\"text-transform:uppercase\">Bank: HDFC Bank</b> <br>\r\n                   <b style=\"text-transform:uppercase\">A/c No.: 00592320003684</b><br>\r\n                   <b style=\"text-transform:uppercase\">IFSC Code : HDFC0000059</b> \r\n                </td>\r\n                <td class=\"tg-0lax\" colspan=\"2\" width=\"33%\">\r\n                   <p style=\"text-align:left;\"><b></b></p> \r\n                    \r\n                </td>\r\n                <td class=\"tg-0lax\" colspan=\"2\" width=\"33%\">\r\n                   <p style=\"text-align:center;\"><br><br><br><b>Authorised Signature</b></p> \r\n                    \r\n                </td>\r\n         </tr>\r\n        </tbody>\r\n    </table>\r\n    {% if print_settings.repeat_header_footer %}\r\n\t<div id=\"footer-html\" class=\"hidden-pdf\" style=\"margin-top:0px!important;\">\r\n\t\t{% if not no_letterhead and footer %}\r\n\t\t<div class=\"letter-head-footer\">\r\n\t\t\t{{ footer }}\r\n\t\t</div>\r\n\t\t{% endif %}\r\n\t\t<p class=\"text-center small page-number visible-pdf\">\r\n\t\t\t{{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\r\n\t\t</p>\r\n\t</div>\r\n\t{% endif %}\r\n  \r\n</div>\r\n\r\n",
